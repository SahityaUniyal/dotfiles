alias vi="nvim"

# git alias
git config --global alias.dbs &>/dev/null || \
    git config --global alias.dbs '!f() { branches=$(git branch --format="%(refname:short)" | fzf --multi); [[ -n "$branches" ]] && echo "$branches" | xarg git branch -D; }; f'

_tmux_attach() {
    if [[ -n "$TMUX" ]]; then
        tmux switch-client -t "$1"
    else
        tmux attach -t "$1"
    fi
}

tm() {
    local session
    session=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | fzf)
    if [[ -n "$session" ]]; then
        _tmux_attach "$session"
    fi
}

